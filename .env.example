# ==============================================================================
# HAPPY KIDS SCHOOL - FULL-STACK ENVIRONMENT VARIABLES
# Copy this file to .env for local development or add them in Netlify Environment Settings
# ==============================================================================

# 1. FRONTEND ENVIRONMENT VARIABLES (React / Vite)
# Only required if deploying frontend separately from backend.
# If deploying together on Netlify, leave blank (it uses relative path /api/admission automatically).
VITE_API_BASE_URL=/api/admission

# 2. BACKEND SERVER CONFIGURATION
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MAX_FILE_SIZE_MB=5

# 3. DATABASE CONFIGURATION (MySQL)
# Note: If MySQL is offline or not configured, the backend automatically uses
# the local JSON Fallback Store (/backend/data/fallback_admissions.json).
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=happy_kids_school
DB_PORT=3306
