{
  "name": "happy-kids-school-admission-system",
  "version": "1.0.0",
  "private": true,
  "description": "Happy Kids School Admission Application Form Full-Stack Application",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "install:all": "npm --workspaces install",
    "dev": "concurrently --names \"API,WEB\" -c \"blue,green\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "serverless-http": "^4.0.0"
  }
}
